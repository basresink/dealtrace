{
  "name": "dealtrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dealtrace: werkplek voor new business van accountmanagers binnendienst en buitendienst",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt build",
    "build:netlify": "tsx tools/netlify/bouw.ts",
    "preview": "nuxt preview --port 3000",
    "postinstall": "nuxt prepare",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx server/db/migreer.ts",
    "seed": "tsx server/db/seed.ts",
    "db:reset": "tsx server/db/migreer.ts --opnieuw && tsx server/db/seed.ts",
    "test": "vitest run tests/unit",
    "test:db": "tsx tools/wegwerpdb/draai.ts",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "check:functies": "tsx tools/checks/check-functies.ts",
    "check:rechten": "tsx tools/checks/check-rechten.ts",
    "check": "pnpm check:functies && pnpm check:rechten && pnpm check:platform && pnpm test",
    "check:platform": "tsx tools/checks/check-platform.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.6.1",
    "pg": "^8.23.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
