# Kopieer dit bestand naar .env en pas aan waar nodig. Geheimen nooit in git.

# Verbinding van de app met de database, als de beperkte rol dealtrace_app (valt onder RLS).
DATABASE_URL=postgresql://dealtrace_app:dealtrace_app@127.0.0.1:5432/dealtrace

# Verbinding voor migraties en seed, als eigenaar van de tabellen (postgres).
# Met Supabase lokaal (supabase start) is dit postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_BEHEER=postgresql://postgres:postgres@127.0.0.1:5432/dealtrace

# Wachtwoord dat de migratie aan de rol dealtrace_app geeft (alleen lokaal; in productie een sterk wachtwoord).
DATABASE_APP_WACHTWOORD=dealtrace_app

# Geheim voor het ondertekenen van de sessiecookie. Lokaal mag dit zo blijven.
SESSIE_GEHEIM=lokaal-ontwikkelgeheim-niet-voor-productie-gebruiken

# Inloggen: 'ontwikkel' toont een lijst testgebruikers (tot P27 inloggen met een code per mail bouwt).
AUTH_MODUS=ontwikkel

# AI: 'mock' werkt zonder sleutel en zonder kosten. Met een eigen sleutel kan 'anthropic'.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
